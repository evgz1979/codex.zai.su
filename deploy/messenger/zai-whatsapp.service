[Unit]
Description=Z AI Messenger WhatsApp browser
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=zai-whatsapp
Group=zai-messenger
WorkingDirectory=/opt/zai-messenger/current
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=128
Environment=WHATSAPP_BROWSER_SOCKET=/run/zai-whatsapp/control.sock
Environment=WHATSAPP_BROWSER_DATA=/var/lib/zai-whatsapp
Environment=WHATSAPP_CHROME_PATH=/opt/google/chrome/chrome
Environment=LD_LIBRARY_PATH=/opt/zai-whatsapp/runtime/usr/lib/x86_64-linux-gnu:/opt/zai-whatsapp/runtime/lib/x86_64-linux-gnu
ExecStart=/usr/local/bin/node /opt/zai-messenger/current/dist/server/backend/connectors/whatsapp/worker.js
Restart=on-failure
RestartSec=10s
TimeoutStopSec=15s
KillMode=control-group
UMask=0077
StateDirectory=zai-whatsapp
StateDirectoryMode=0700
RuntimeDirectory=zai-whatsapp
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
MemoryHigh=512M
MemoryMax=640M
MemorySwapMax=0
OOMPolicy=kill
CPUQuota=35%
CPUWeight=10
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
