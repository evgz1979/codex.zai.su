[Unit]
Description=Z AI Messenger
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=zai-messenger
Group=zai-messenger
WorkingDirectory=/opt/zai-messenger/current
Environment=NODE_ENV=production
Environment=MESSENGER_DATA_DIR=/var/lib/zai-messenger
Environment=MESSENGER_PUBLIC_ORIGIN=https://msg.zai.su:8443
Environment=NODE_OPTIONS=--max-old-space-size=256
ExecStart=/usr/local/bin/node /opt/zai-messenger/current/dist/server/backend/index.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0077
StateDirectory=zai-messenger
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=512M
MemoryHigh=384M
CPUWeight=20
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
