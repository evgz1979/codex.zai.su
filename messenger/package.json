{
  "name": "z-ai-messenger",
  "version": "0.16.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "dev": "tsx watch backend/index.ts",
    "setup": "tsx backend/cli.ts setup",
    "cache:clear": "tsx backend/cli.ts clear",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --config frontend/vite.config.ts && tsc -p tsconfig.server.json",
    "start": "bash scripts/start.sh",
    "test": "node --import tsx --test test/*.test.ts",
    "test:browser": "playwright test",
    "docs:build": "node scripts/build-documentation.mjs",
    "docs:check": "node scripts/build-documentation.mjs --check",
    "docs:test": "node --test test/documentation.test.mjs",
    "icons:build": "node scripts/build-icons.mjs",
    "deploy": "bash ../deploy/messenger/deploy.sh"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "teleproto": "1.232.1",
    "web-push": "4.0.0",
    "whatsapp-web.js": "1.34.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  },
  "overrides": {
    "whatsapp-web.js": {
      "puppeteer": "25.16.0"
    },
    "basic-ftp": "6.2.6",
    "zod": "4.6.7"
  }
}
