{
  "name": "z-ai-messenger",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "dev": "tsx watch backend/index.ts",
    "setup": "tsx backend/cli.ts setup",
    "cache:clear": "tsx backend/cli.ts clear",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --config frontend/vite.config.ts && tsc -p tsconfig.server.json",
    "start": "bash scripts/start.sh",
    "test": "node --import tsx --test test/*.test.ts",
    "test:browser": "playwright test",
    "docs:build": "node scripts/build-documentation.mjs",
    "docs:check": "node scripts/build-documentation.mjs --check",
    "docs:test": "node --test test/documentation.test.mjs",
    "deploy": "bash ../deploy/messenger/deploy.sh"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "teleproto": "1.232.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
