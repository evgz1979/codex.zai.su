{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "jsx": "react-jsx",
    "resolveJsonModule": true, "noEmit": true
  },
  "include": ["backend", "frontend", "shared", "test", "playwright.config.ts"]
}
