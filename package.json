{
  "name": "codex-z-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.16.0 <23" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "tsx watch backend/src/index.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "typecheck": "tsc --noEmit -p backend/tsconfig.json && tsc --noEmit -p frontend/tsconfig.json",
    "build": "npm run typecheck && tsc -p backend/tsconfig.build.json && vite build --config frontend/vite.config.ts",
    "start": "node backend/dist/backend/src/index.js",
    "test": "node --import tsx --test backend/test/*.test.ts",
    "test:live": "node scripts/live-test.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
